# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Caminho para o arquivo JSON da service account do Google
GOOGLE_CREDENTIALS_PATH=./credenciais-google.json

# ID da planilha do Google Sheets (fica na URL, entre /d/ e /edit)
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# --- Meta WhatsApp Cloud API (developers.facebook.com) ---
# Use as credenciais de QUALQUER UM dos dois apps que você criou —
# como os dois compartilham o mesmo número de teste, tanto faz qual.
# Recomendo usar o token permanente que você já gerou.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=escolha-uma-senha-aqui
